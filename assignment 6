import pandas as pd

data = {
    'Name': ['Amit', 'Riya', 'Amit'],
    'Marks': [80, 90, None],
    'City': ['Pune', 'Mumbai', 'Pune']
}

df = pd.DataFrame(data)

print(df)

df['Marks'] = df['Marks'].fillna(df['Marks'].mean())
df = df.drop_duplicates()

print("Cleaned Data:")

print(df)
print("Duplicate Data:")

print(df.head())
print(df.describe())
